generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  phone            String?           @unique
  name             String?
  role             UserRole          @default(PATIENT)
  isVerified       Boolean           @default(false)
  isActive         Boolean           @default(true)
  lastSentAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  email            String?           @unique
  auditLogs        AuditLog[]
  notifications    Notification[]
  otpVerifications OtpVerification[]
  patient          Patient?
  staffProfile     StaffProfile?

  @@index([phone])
  @@index([email])
}

model Patient {
  id             String        @id @default(cuid())
  userId         String        @unique
  fullName       String        @default("Patient")
  dateOfBirth    DateTime?
  gender         Gender?
  priorityStatus PriorityType  @default(REGULAR)
  consentGiven   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StaffProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  fullName          String
  departmentId      String?
  specialization    String?
  roomNumber        String?
  isActive          Boolean      @default(true)
  avgServiceMinutes Float        @default(6.0)
  isDoctor          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  queues            QueueEntry[]
  department        Department?  @relation(fields: [departmentId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([departmentId])
}

model Department {
  id           String         @id @default(cuid())
  name         String         @unique
  code         String         @unique
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  appointments Appointment[]
  queueEntries QueueEntry[]
  staff        StaffProfile[]

  @@index([code])
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  staffProfileId  String?
  departmentId    String
  appointmentDate DateTime
  slotStart       DateTime?
  slotEnd         DateTime?
  status          AppointmentStatus @default(BOOKED)
  isWalkIn        Boolean           @default(false)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  department      Department        @relation(fields: [departmentId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  notifications   Notification[]
  queueEntry      QueueEntry?

  @@index([patientId])
  @@index([departmentId])
  @@index([staffProfileId])
  @@index([appointmentDate])
}

model QueueEntry {
  id                    String           @id @default(cuid())
  appointmentId         String           @unique
  departmentId          String
  staffProfileId        String?
  tokenNumber           String
  tokenDisplay          String
  priority              PriorityType     @default(REGULAR)
  priorityScore         Int              @default(0)
  position              Int              @default(0)
  status                QueueEntryStatus @default(WAITING)
  notificationSent      Boolean          @default(false)
  estimatedWaitMinutes  Float?
  joinedAt              DateTime         @default(now())
  calledAt              DateTime?
  consultationStartedAt DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  predictionLogs        PredictionLog[]
  appointment           Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  department            Department       @relation(fields: [departmentId], references: [id])
  staffProfile          StaffProfile?    @relation(fields: [staffProfileId], references: [id])
  serviceRecord         ServiceRecord?

  @@index([departmentId])
  @@index([staffProfileId])
  @@index([status])
  @@index([joinedAt])
}

model ServiceRecord {
  id                     String     @id @default(cuid())
  queueEntryId           String     @unique
  consultationStart      DateTime
  consultationEnd        DateTime?
  serviceDurationMinutes Float?
  waitDurationMinutes    Float?
  createdAt              DateTime   @default(now())
  queueEntry             QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id          String    @id @default(cuid())
  userId      String
  phone       String?
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  email       String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  appointmentId String?
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appointmentId])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  timestamp   DateTime    @default(now())
  actor       User?       @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([timestamp])
}

model PredictionLog {
  id              String     @id @default(cuid())
  queueEntryId    String
  predictedWait   Float
  actualWait      Float?
  lowerBound      Float?
  upperBound      Float?
  modelVersion    String     @default("rule-based-v1")
  featureSnapshot Json?
  createdAt       DateTime   @default(now())
  queueEntry      QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([queueEntryId])
}

enum UserRole {
  PATIENT
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PriorityType {
  REGULAR
  ELDERLY
  PREGNANCY
  EMERGENCY
}

enum AppointmentStatus {
  BOOKED
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  NO_SHOW
  CANCELLED
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  NO_SHOW
}

enum NotificationType {
  THREE_TURNS_AWAY
  YOUR_TURN
  CONSULTATION_COMPLETE
  APPOINTMENT_REMINDER
  GENERAL
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  OTP_SENT
  OTP_VERIFIED
  APPOINTMENT_BOOKED
  QUEUE_JOINED
  PATIENT_CALLED
  PATIENT_SKIPPED
  PATIENT_NO_SHOW
  CONSULTATION_STARTED
  CONSULTATION_COMPLETED
  PRIORITY_CHANGED
  DOCTOR_CREATED
  DEPARTMENT_CREATED
  DOCTOR_UPDATED
  DEPARTMENT_UPDATED
}
